GOOGLE_AUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/google/callback
EMAIL_DELAY_SECONDS=1.0

# Outlook/Microsoft OAuth Configuration (Optional)
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:8000/api/outlook/callback
OUTLOOK_TENANT=consumers

# GPT API Configuration (Optional - for interview detection)
GPT_API_KEY=your-openai-api-key